{{- $distro := promptStringOnce . "distro" "Distro types (arch, debian, ubuntu) -- Raspberry Pi OS = debian" -}}

{{- $desktop_env := promptStringOnce . "desktop_env" "Desktop env types (hyprland, kde, gnome, none)"}}
{{- $hasGui := promptBoolOnce . "has_gui" "Does this machine have a GUI?" -}}

data:
  distro: {{ $distro | quote }}
  desktop_env: {{$desktop_env | quote}}
  has_gui: {{ $hasGui }}
